################################################################################
# BountyBreach.com Foundation-Proxy Environment Configuration
#
# Copy this file to foundation-proxy/.env and update with your production values
# 
# Required Variables (must be configured):
#   - BB_PROXY_FOUNDATION_BASE_URL: URL of the bountybreach-ai-foundation backend
#   - BB_PROXY_FOUNDATION_TOKEN: Authentication token for the backend
#
# Optional Variables (sensible defaults provided):
#   - PORT: Express server port (default: 9091)
#   - BB_PROXY_TENANT_ID: Tenant identifier (default: public)
#   - BB_PROXY_ROLE: User role for AI requests (default: analyst)
#   - BB_PROXY_ALLOWED_ORIGINS: CORS allowed origins (comma-separated)
#   - BB_PROXY_TIMEOUT_MS: General timeout (default: 20000)
#   - BB_PROXY_AUTH_TIMEOUT_MS: Auth check timeout (default: 15000)
#   - BB_PROXY_CHAT_TIMEOUT_MS: Chat/LLM timeout (default: 120000)
#
################################################################################

# Production Environment
NODE_ENV=production

# Express Server Port
# The port foundation-proxy listens on (nginx will proxy to this)
PORT=9091

################################################################################
# REQUIRED: BountyBreach AI Foundation Backend Configuration
################################################################################

# Backend Base URL
# Example: https://api.bountybreach.com or http://localhost:8000
BB_PROXY_FOUNDATION_BASE_URL=https://your-backend-url.bountybreach.com

# Backend Authentication Token
# This token is used to authenticate requests to the foundation backend
# Example: sk_test_51234567890abcdef
BB_PROXY_FOUNDATION_TOKEN=your-foundation-token-here

################################################################################
# Optional: Tenant and Role Configuration
################################################################################

# Tenant ID for multi-tenant deployments
# Default: public
BB_PROXY_TENANT_ID=production

# Default user role for AI analysis requests
# Default: analyst
BB_PROXY_ROLE=analyst

################################################################################
# Optional: CORS Configuration
################################################################################

# Allowed Origins for CORS (comma-separated)
# Examples:
#   - Single origin: https://bountybreach.com
#   - Multiple origins: https://bountybreach.com,https://www.bountybreach.com,https://admin.bountybreach.com
# If not set, CORS is not restricted (all origins allowed)
BB_PROXY_ALLOWED_ORIGINS=https://bountybreach.com,https://www.bountybreach.com

# Allowed Agents (comma-separated agent IDs that can be used)
# If set, only requests with these agent IDs will be processed
# Leave empty to allow any agent
BB_PROXY_ALLOWED_AGENTS=

################################################################################
# Optional: Timeout Configuration (in milliseconds)
################################################################################

# General Request Timeout
# Used as default for requests that don't have specific timeout settings
# Min: 1000ms (1 second), Recommended: 20000ms (20 seconds)
BB_PROXY_TIMEOUT_MS=20000

# Authentication Check Timeout
# Used for /upstream/auth-check endpoint (should be fast)
# Min: 1000ms, Recommended: 15000ms (15 seconds)
BB_PROXY_AUTH_TIMEOUT_MS=15000

# Chat / LLM Request Timeout
# Used for /api/v1/ai/chat endpoint (LLM responses can be slow)
# Min: 1000ms, Recommended: 120000ms (2 minutes) for local models
BB_PROXY_CHAT_TIMEOUT_MS=120000

################################################################################
# Optional: Request Size Limits
################################################################################

# Request Body Size Limit
# Useful to prevent large payload attacks
# Default: 256kb
# Examples: 256kb, 1mb, 10mb
BB_PROXY_BODY_LIMIT=256kb

################################################################################
# Optional: Agent Configuration
################################################################################

# Agent ID to use for requests (if not provided in request)
# Leave empty to require agent ID in every request
BB_PROXY_AGENT_ID=

################################################################################
# Deployment Notes
################################################################################

# For EC2 Deployment:
# 1. Ensure the backend URL is accessible from your EC2 instance
# 2. Use Elastic IPs for consistent access
# 3. Keep your foundation token secure - use AWS Secrets Manager or similar
# 4. Test connectivity: curl -H "Authorization: Bearer YOUR_TOKEN" https://your-backend-url.bountybreach.com/health
#
# For Local Development:
# 1. Set BB_PROXY_FOUNDATION_BASE_URL to http://localhost:8000
# 2. Run the foundation backend on port 8000
# 3. Run foundation-proxy: npm run start
# 4. Test: curl http://localhost:9091/upstream/auth-check
#
# SSL/TLS:
# - Nginx (port 443) handles SSL termination
# - Foundation-proxy only needs to be accessible on localhost:9091
# - Never expose foundation-proxy directly to the internet
#
